{
  "name": "ectoplasm",
  "displayName": "Ectoplasm",
  "description": "A dark color theme foundation for the Ectoplasm visual identity.",
  "version": "0.9.0",
  "type": "module",
  "publisher": "madebyspook",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=22"
  },
  "categories": ["Themes"],
  "keywords": ["ectoplasm", "dark", "theme"],
  "main": "./runtime/extension.cjs",
  "extensionKind": ["ui"],
  "activationEvents": ["onStartupFinished"],
  "repository": {
    "type": "git",
    "url": "https://github.com/madebyspook/Ectoplasm-vsCode.git"
  },
  "contributes": {
    "commands": [
      { "command": "ectoplasm.enableGlow", "title": "Ectoplasm: Enable Glow" },
      { "command": "ectoplasm.disableGlow", "title": "Ectoplasm: Disable Glow" }
    ],
    "themes": [
      {
        "label": "Ectoplasm",
        "uiTheme": "vs-dark",
        "path": "./themes/Ectoplasm-color-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node --watch scripts/build.mjs",
    "check": "node scripts/build.mjs --check && node --check glow/ectoplasm-glow.js && node --check runtime/extension.cjs && node --check runtime/workbench.cjs",
    "vscode:prepublish": "npm run build && npm run check",
    "package": "vsce package --no-dependencies --out ectoplasm.vsix",
    "install:local": "npm run package && code --install-extension ectoplasm.vsix --force"
  },
  "devDependencies": {
    "@vscode/vsce": "4.1.0"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "11.0.1"
    }
  }
}
