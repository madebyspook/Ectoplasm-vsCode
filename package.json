{
  "name": "ectoplasm",
  "displayName": "Ectoplasm",
  "description": "A dark color theme foundation for the Ectoplasm visual identity.",
  "version": "0.3.1",
  "type": "module",
  "publisher": "madebyspook",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=22"
  },
  "categories": ["Themes"],
  "keywords": ["ectoplasm", "dark", "theme"],
  "repository": {
    "type": "git",
    "url": "https://github.com/madebyspook/Ectoplasm-vsCode.git"
  },
  "contributes": {
    "themes": [
      {
        "label": "Ectoplasm",
        "uiTheme": "vs-dark",
        "path": "./themes/Ectoplasm-color-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node --watch scripts/build.mjs",
    "check": "node scripts/build.mjs --check && node scripts/check.mjs && node --test tests/*.test.mjs",
    "test": "npm run build && npm run check",
    "vscode:prepublish": "npm test",
    "package": "vsce package --no-dependencies --out ectoplasm.vsix",
    "install:local": "npm run package && code --install-extension ectoplasm.vsix --force"
  },
  "devDependencies": {
    "@vscode/vsce": "4.1.0"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "11.0.1"
    }
  }
}
