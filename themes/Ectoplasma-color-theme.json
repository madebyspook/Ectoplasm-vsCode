{
  "$schema": "vscode://schemas/color-theme",
  "name": "Ectoplasma",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#1F1F1F",
    "editor.foreground": "#D4D4D4",
    "sideBar.background": "#181818",
    "sideBar.foreground": "#CCCCCC",
    "activityBar.background": "#181818",
    "panel.background": "#181818",
    "panel.border": "#2B2B2B",
    "editorGroupHeader.tabsBackground": "#181818",
    "tab.activeBackground": "#1F1F1F",
    "tab.activeForeground": "#FFFFFF",
    "tab.inactiveBackground": "#181818",
    "tab.inactiveForeground": "#9D9D9D",
    "titleBar.activeBackground": "#181818",
    "titleBar.inactiveBackground": "#1F1F1F",
    "statusBar.background": "#181818",
    "statusBar.foreground": "#CCCCCC",
    "statusBar.noFolderBackground": "#181818",
    "statusBar.debuggingBackground": "#181818",
    "menu.background": "#1F1F1F",
    "dropdown.background": "#313131",
    "input.background": "#313131",
    "editorWidget.background": "#202020",
    "quickInput.background": "#222222",
    "terminal.background": "#181818",
    "focusBorder": "#0078D4",
    "button.background": "#0078D4",
    "button.foreground": "#FFFFFF",
    "textLink.foreground": "#4DAAFC"
  },
  "tokenColors": [
    {"name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": {"foreground": "#6A9955"}},
    {"name": "Keywords and storage", "scope": ["keyword", "storage"], "settings": {"foreground": "#569CD6"}},
    {"name": "Strings", "scope": "string", "settings": {"foreground": "#CE9178"}},
    {"name": "Numbers and constants", "scope": ["constant.numeric", "constant.language"], "settings": {"foreground": "#B5CEA8"}},
    {"name": "Functions", "scope": ["entity.name.function", "support.function"], "settings": {"foreground": "#DCDCAA"}},
    {"name": "Types", "scope": ["entity.name.type", "support.type", "support.class"], "settings": {"foreground": "#4EC9B0"}},
    {"name": "Variables", "scope": ["variable", "entity.other.attribute-name"], "settings": {"foreground": "#9CDCFE"}},
    {"name": "Tags", "scope": "entity.name.tag", "settings": {"foreground": "#569CD6"}},
    {"name": "Markdown headings", "scope": ["markup.heading", "entity.name.section"], "settings": {"foreground": "#569CD6", "fontStyle": "bold"}},
    {"name": "Invalid tokens", "scope": "invalid", "settings": {"foreground": "#F44747"}}
  ],
  "semanticTokenColors": {
    "type": "#4EC9B0",
    "class": "#4EC9B0",
    "interface": "#4EC9B0",
    "enum": "#4EC9B0",
    "typeParameter": "#4EC9B0",
    "function": "#DCDCAA",
    "method": "#DCDCAA",
    "variable": "#9CDCFE",
    "parameter": "#9CDCFE",
    "property": "#9CDCFE",
    "enumMember": "#B5CEA8"
  }
}
