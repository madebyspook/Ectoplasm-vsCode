  "tokenColors": [
    {
      "name": "General code",
      "scope": [
        "source",
        "meta.embedded",
        "meta.template.expression",
        "meta.fstring"
      ],
      "settings": {
        "foreground": "#A7BAD9"
      }
    },
    {
      "name": "Operators and separators",
      "scope": [
        "keyword.operator",
        "punctuation.terminator",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#6A7C99"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#9EC3FF"
      }
    },
    {
      "name": "SCSS Color Syntax",
      "scope": [
        "variable.parameter.url.scss"
      ],
      "settings": {
        "foreground": "#4545D9"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable.other.readwrite",
        "variable.other.local",
        "variable.scss",
        "variable.sass",
        "variable.other.scss",
        "variable.other.sass"
      ],
      "settings": {
        "foreground": "#9EC3FF"
      }
    },
    {
      "name": "SCSS color function keywords",
      "scope": [
        "support.function.color.scss",
        "support.function.color.sass"
      ],
      "settings": {
        "foreground": "#4545D9"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#F044C8"
      }
    },
    {
      "name": "Language keywords and types",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#4545D9"
      }
    },
    {
      "name": "Functions and calls",
      "scope": [
        "entity.name.function",
        "variable.function",
        "support.function",
        "meta.function-call.generic.python"
      ],
      "settings": {
        "foreground": "#E0ECFF"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#00d9f5"
      }
    },
    {
      "name": "String punctuation and prefixes",
      "scope": [
        "string punctuation",
        "punctuation.definition.string",
        "storage.type.string"
      ],
      "settings": {
        "foreground": "#A7BAD9"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "comment punctuation"
      ],
      "settings": {
        "foreground": "#4F6280"
      }
    }
  ],
  "semanticTokenColors": {
    "*": "#A7BAD9",
    "comment": "#4F6280",
    "string": "#00d9f5",
    "variable": "#9EC3FF",
    "parameter": "#9EC3FF",
    "property": "#A7BAD9",
    "enumMember": "#F044C8",
    "type": "#4545D9",
    "class": "#4545D9",
    "interface": "#4545D9",
    "typeParameter": "#4545D9",
    "function": "#E0ECFF",
    "method": "#E0ECFF",
    "number": "#F044C8"
  }
}
