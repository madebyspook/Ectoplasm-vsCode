  "tokenColors": [
    {
      "name": "Default syntax",
      "scope": [
        "keyword",
        "storage",
        "constant",
        "variable",
        "entity",
        "support",
        "meta",
        "punctuation",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#BBD0F2"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#8CD289"
      }
    },
    {
      "name": "String punctuation",
      "scope": [
        "punctuation.definition.string",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#BBD0F2"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#4F6280"
      }
    }
  ],
  "semanticTokenColors": {
    "*": "#BBD0F2",
    "comment": "#4F6280",
    "string": "#8CD289"
  }
